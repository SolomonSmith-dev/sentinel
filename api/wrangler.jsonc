{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [{ "pattern": "sentinel.solomonsmith.dev", "custom_domain": true }],
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sentinel",
      "database_id": "b4f85b23-d793-4ea3-ba01-051b6c98fc15",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "READ_LIMITER", "namespace_id": "7302", "simple": { "limit": 120, "period": 60 } },
    { "name": "READ_MISS_LIMITER", "namespace_id": "7303", "simple": { "limit": 120, "period": 60 } },
    {
      "name": "INGEST_LIMITER",
      // Account-unique integer id for this namespace.
      "namespace_id": "7301",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": { "INGEST_ENABLED": "true", "TELEMETRY_READS_ENABLED": "true",
    "ACCESS_ISSUER": "https://jellyfinsolo.cloudflareaccess.com",
    "ACCESS_AUD": "dfb9f0771dc7923cefbfea08c3d2bba4ad45ef996e41aef4641da6ac31a1e5b7",
    "ACCESS_EMAIL": "solomonsmithdev@gmail.com" },
  "triggers": { "crons": ["*/5 * * * *", "17 3 * * *"] }
  // SENTINEL_TOKEN is a secret: `wrangler secret put SENTINEL_TOKEN`. Local dev reads .dev.vars.
}
