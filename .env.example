# earendil sensor config. Copy to .env, never commit .env.
SENTINEL_IFACE=eth0
SENTINEL_API=https://sentinel.solomonsmith.dev/api/ingest
SENTINEL_SENSOR_ID=sensor-01
# openssl rand -hex 32  (same value as the Worker secret SENTINEL_TOKEN)
SENTINEL_TOKEN=
# openssl rand -hex 32  (lives only on earendil)
SENTINEL_SALT=
